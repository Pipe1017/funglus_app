# ===========================================
# CONFIGURACIÓN DE FUNGLUSAPP
# ===========================================
# Copia este archivo a .env y ajusta los valores

# ===========================================
# BASE DE DATOS
# ===========================================
POSTGRES_USER=funglusapp
POSTGRES_PASSWORD=CAMBIAR_EN_PRODUCCION
POSTGRES_DB=funglusapp

# URL de conexión completa (ajustar password)
DATABASE_URL=postgresql://funglusapp:CAMBIAR_EN_PRODUCCION@db:5432/funglusapp

# ===========================================
# BACKEND - CORS
# ===========================================
# Para desarrollo local: http://localhost,http://192.168.1.X
# Para producción: https://tudominio.com
BACKEND_CORS_ORIGINS=http://localhost,http://192.168.1.19

# ===========================================
# FRONTEND - API URL
# ===========================================
# Para desarrollo local: http://localhost:8000/api/v1
# Para red local: http://192.168.1.X:8000/api/v1
# Para producción: https://api.tudominio.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1
